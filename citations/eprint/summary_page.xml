<?xml version="1.0" ?>

<!-- 
	Full "abstract page" (or splash page or summary page, depending on your jargon) for an eprint. 
-->

<cite:citation xmlns="http://www.w3.org/1999/xhtml" xmlns:epc="http://eprints.org/ep3/control" xmlns:cite="http://eprints.org/ep3/citation" >

  <p style="margin-bottom: 1em">
    <epc:print expr="$item.citation($config{citation_default}{eprint}{for_summary_page})" />
  </p>


  <epc:if test="$flags{has_multiple_versions}">
    <div style="margin-bottom: 1em">
      <epc:print expr="$multi_info" />
    </div>
  </epc:if>


  <epc:if test="length($item.documents()) = 0">
    <epc:phrase ref="page:nofulltext" />
    <epc:if test="$item.contact_email().is_set() and eprint_status = 'archive'">
      (<a href="{$config{perl_url}}/request_doc?eprintid={eprintid}"><epc:phrase ref="request:button" /></a>)
    </epc:if>
  </epc:if>


  <section id="documents">
    <epc:if test="$document_video_player"> 
      <details open="">
        <summary><h2>Online Video</h2></summary>
        <epc:print expr="$document_video_player" />
      </details>
    </epc:if>

    <epc:if test="$document_image"> 
      <details>
        <summary><h2>Images</h2></summary>
        <epc:print expr="$document_image" />
      </details>
    </epc:if>

    <epc:if test="$document_spreadsheet"> 
      <details>
        <summary><h2>Spreadsheet</h2></summary>
        <epc:print expr="$document_spreadsheet" />
      </details>
    </epc:if>

    <epc:if test="$document_video"> 
      <details>
        <summary><h2>Videos</h2></summary>
        <epc:print expr="$document_video" />
      </details>
    </epc:if>

    <epc:if test="$document_audio"> 
      <details>
        <summary><h2>Audio</h2></summary>
        <epc:print expr="$document_audio" />
      </details>
    </epc:if>

    <epc:if test="$document_slideshow"> 
      <details>
        <summary><h2>Slideshows</h2></summary>
        <epc:print expr="$document_slideshow" />
      </details>
    </epc:if>

    <epc:if test="$document_text"> 
      <details>
        <summary><h2>Documents</h2></summary>
        <epc:print expr="$document_text" />
      </details>
    </epc:if>

    <epc:if test="$document_archive"> 
      <details>
        <summary><h2>Archive</h2></summary>
        <epc:print expr="$document_archive" />
      </details>
    </epc:if>


    <epc:if test="$document_other"> 
      <details>
        <summary><h2>Other</h2></summary>
        <epc:print expr="$document_other" />
      </details>
    </epc:if>


    <details>
      <summary><h2>Further Details</h2></summary>
      
        <epc:if test="official_url">
          <div style="margin-bottom: 1em">
            <epc:phrase ref="eprint_fieldname_official_url"/>: <epc:print expr="official_url" />
          </div>
        </epc:if>

        <epc:if test="abstract">
          <h2><epc:phrase ref="eprint_fieldname_abstract"/></h2>
          <div style="text-align: left; margin: 1em auto 0em auto"><epc:print expr="abstract" /></div>
        </epc:if>


        <table style="margin-bottom: 1em; margin-top: 1em;" cellpadding="3">
          <tr>
            <th align="right"><epc:phrase ref="eprint_fieldname_type" />:</th>
            <td>
              <epc:print expr="type" />
              <epc:if test="type = 'conference_item'">(<epc:print expr="pres_type" />)</epc:if>
              <epc:if test="type = 'monograph'">(<epc:print expr="monograph_type" />)</epc:if>
              <epc:if test="type = 'thesis'">(<epc:print expr="thesis_type" />)</epc:if>
            </td>
          </tr>

          <epc:comment> 
            The below block loops over a list of field names taken from eprint_render.pl
            Edit the list of metadata to show in the summary page table in eprint_render.pl
          </epc:comment>
          <epc:foreach expr="$config{summary_page_metadata}" iterator="fieldname">
            <epc:if test="is_set($item.property($fieldname))">
              <tr>
                <th align="right"><epc:phrase ref="eprint_fieldname_{$fieldname}" />:</th>
                <td valign="top"><epc:print expr="$item.property($fieldname)" /></td>
              </tr>
            </epc:if>
          </epc:foreach>

          <tr>
            <th align="right">URI:</th>
            <td valign="top"><a href="{$item.uri()}"><epc:print expr="$item.uri()" /></a></td>
          </tr>
        </table>
      </details>
  </section>

  <epc:if test="$flags{has_multiple_versions}">
    <epc:phrase ref="page:available_versions" />
    <epc:print expr="$version_tree" />
  </epc:if>
  <epc:if test="$flags{in_commentary_thread}">
    <epc:phrase ref="page:commentary_threads" />
    <epc:print expr="$commentary_tree" />
  </epc:if>

  <epc:if test="!$flags{preview}">
    <epc:phrase ref="summary_page:actions"/>
    <dl class="ep_summary_page_actions">
    <epc:foreach expr="action_list('eprint_summary_page_actions',$item)" iterator="action">
      <dt><epc:print expr="$action.action_icon()" /></dt>
      <dd><epc:print expr="$action.action_title()" /></dd>
    </epc:foreach>
    </dl>
  </epc:if>

</cite:citation>

